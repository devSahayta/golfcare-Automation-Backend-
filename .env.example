# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KINDE_DOMAIN=
SAMVAADIK_API_BASE_URL=
SAMVAADIK_API_KEY=
SAMVAADIK_WEBHOOK_SECRET=
# Resend API key (module 5.2 — ProductDraft approval emails)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
APPROVAL_LINK_BASE_URL=http://localhost:4000
API_PORT=4000
NODE_ENV=development

SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_BASE_URL=
# Optional — only needed if the store has more than one Shopify location
SHOPIFY_LOCATION_ID=
# Placeholder inventory qty written to Shopify for IN_STOCK/ON_ORDER (module 2)
SHOPIFY_DEFAULT_AVAILABLE_QTY=99
# Hours before a confirmed AvailabilityState decays to UNKNOWN (module 2)
AVAILABILITY_TTL_HOURS=168

ANTHROPIC_MODEL=
DISCOUNT_CEILING_PERCENT=
HANDOVER_VALUE_THRESHOLD_INR=
AGENT_MAX_TOOL_ITERATIONS=
AGENT_HISTORY_MESSAGE_LIMIT=
AGENT_PROCESSING_LOCK_STALE_MINUTES=
# Cap on extracted text from a supplier-sent PDF/sheet attachment before it
# becomes a Message.body
DOCUMENT_EXTRACT_MAX_CHARS=20000

# Module 5.2 — where new-product ProductDraft approval emails go
STAFF_APPROVAL_EMAIL=
# Days before a ProductDraft's approval link expires
PRODUCT_DRAFT_TOKEN_EXPIRY_DAYS=7

